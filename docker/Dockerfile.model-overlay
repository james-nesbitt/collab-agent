# Thin overlay over a pinned omp-session image that adds $OMP_MODEL support to the
# entrypoint (pins the interactive TUI model via omp --model, which the mounted
# config file cannot set). Keeps the base image's omp binary unchanged.
#
# Build (base tag pinned to a known-good pre-regression build):
#   docker build -f docker/Dockerfile.model-overlay \
#     --build-arg BASE=ghcr.io/james-nesbitt/collab-agent/omp-session:sha-<pinned> \
#     -t europe-west1-docker.pkg.dev/tools-348616/omp/omp-session:glm-overlay .
#
# Retire this overlay once upstream omp is fixed and the entrypoint change ships
# in the CI-built omp-session image.
ARG BASE
FROM ${BASE}

# Overlay the OMP_MODEL-aware entrypoint (same file the CI image bakes).
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
