#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = [
#     "kubernetes==31.0.0",
#     "google-cloud-secret-manager==2.22.0",
#     "grpc-google-iam-v1",
# ]
# ///
"""
ompctl — omp platform self-service CLI.

Subcommands:
  cred add <key> [--user <name>] [--project <id>]
  cred ls        [--user <name>] [--project <id>]
  vault add <entry> [--project <id>]         (admin; entry: 'shared/<key>' or 'users/<name>/<key>')
  vault ls  [<subtree>] [--project <id>]
  session stop    <name>
  session start   <name>
  session restart <name>
  session link    <name>
  auth <session> <provider> [<container>]    (providers: anthropic gcloud aws aws-configure az gh)
  port-forward <session> <local-port> [<remote-port>]
"""
from __future__ import annotations

import getpass
import os
import re
import subprocess
import sys
from typing import Optional


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def _die(msg: str) -> None:
    print(f"ERROR: {msg}", file=sys.stderr)
    sys.exit(1)


def _info(msg: str) -> None:
    print(f"  {msg}", file=sys.stderr)


def _ok(msg: str) -> None:
    print(f"OK: {msg}")


def _gcloud_account() -> str:
    """Return the active gcloud account (email)."""
    try:
        result = subprocess.run(
            ["gcloud", "config", "get-value", "account"],
            capture_output=True, text=True, check=True,
        )
        account = result.stdout.strip()
        if not account or account == "(unset)":
            _die("No active gcloud account — run: gcloud auth login")
        return account
    except FileNotFoundError:
        _die("gcloud not found — install the Google Cloud SDK")
    except subprocess.CalledProcessError as exc:
        _die(f"gcloud config get-value account failed: {exc.stderr.strip()}")


def _gsm_id(entry: str) -> str:
    """Convert 'users/<name>/<key>' → 'users-<name>-<key>'."""
    return entry.replace("/", "-")


def _subtree_label(entry: str) -> str:
    """'users/<name>/<key>' → 'users-<name>'."""
    parts = entry.rsplit("/", 1)
    return parts[0].replace("/", "-")


def _envvar_name(key: str) -> str:
    """'atlassian-token' → 'ATLASSIAN_TOKEN'."""
    return re.sub(r"[^A-Z0-9_]", "", key.upper().replace("-", "_"))


# ---------------------------------------------------------------------------
# GSM operations (via google-cloud-secret-manager)
# ---------------------------------------------------------------------------

def _gsm_client():
    try:
        from google.cloud import secretmanager
    except ImportError:
        _die("google-cloud-secret-manager not installed — pip install google-cloud-secret-manager")
    return secretmanager.SecretManagerServiceClient()


def _iam_client():
    try:
        from google.cloud import secretmanager_v1
    except ImportError:
        _die("google-cloud-secret-manager not installed")
    # IAM bindings are in the secretmanager client itself
    return _gsm_client()


# ---------------------------------------------------------------------------
# cred add
# ---------------------------------------------------------------------------

def cmd_cred_add(key: str, username: str, project: str, eso_sa: Optional[str]) -> None:
    """Create/update a personal credential in GSM under users/<username>/<key>."""
    # Validate key
    if not re.match(r"^[a-z0-9]([a-z0-9-]*[a-z0-9])?$", key):
        _die(f"Invalid key '{key}': must be a DNS-1123 label (lowercase, digits, hyphens, no leading/trailing hyphen)")

    entry = f"users/{username}/{key}"
    secret_id = _gsm_id(entry)
    subtree_label = _subtree_label(entry)
    parent = f"projects/{project}"
    secret_name = f"{parent}/secrets/{secret_id}"

    # Prompt for value (hidden)
    value = getpass.getpass(f"  Value for '{entry}' (hidden): ")
    if not value:
        _die("Empty value — aborted")

    client = _gsm_client()

    # Create secret if absent
    try:
        client.get_secret(name=secret_name)
        _info(f"Secret '{secret_id}' already exists — adding new version")
    except Exception:  # google.api_core.exceptions.NotFound
        _info(f"Creating GSM secret '{secret_id}'…")
        try:
            client.create_secret(
                parent=parent,
                secret_id=secret_id,
                secret={
                    "replication": {"automatic": {}},
                    "labels": {
                        "omp_vault": "true",
                        "omp_subtree": subtree_label,
                    },
                },
            )
        except Exception as exc:
            _die(f"Failed to create secret: {exc}")

    # Add version
    _info(f"Adding secret version for '{secret_id}'…")
    try:
        client.add_secret_version(
            parent=secret_name,
            payload={"data": value.encode("utf-8")},
        )
    except Exception as exc:
        _die(f"Failed to add secret version: {exc}")

    # Grant ESO SA secretAccessor on this secret
    if eso_sa:
        _info(f"Granting roles/secretmanager.secretAccessor to {eso_sa}…")
        try:
            policy = client.get_iam_policy(resource=secret_name)
            # Find or add secretAccessor binding
            accessor_role = "roles/secretmanager.secretAccessor"
            member = f"serviceAccount:{eso_sa}"
            for binding in policy.bindings:
                if binding.role == accessor_role:
                    if member not in binding.members:
                        binding.members.append(member)
                    break
            else:
                from google.iam.v1 import policy_pb2
                policy.bindings.add(role=accessor_role, members=[member])
            client.set_iam_policy(resource=secret_name, policy={"policy": policy})
        except Exception as exc:
            print(f"  WARNING: IAM grant failed — {exc}", file=sys.stderr)
            print(f"  Manual fix: gcloud secrets add-iam-policy-binding {secret_id}"
                  f" --project={project} --member=serviceAccount:{eso_sa}"
                  f" --role=roles/secretmanager.secretAccessor", file=sys.stderr)
    else:
        print(
            f"  WARNING: OMP_ESO_SA not set — ESO cannot access '{secret_id}' until you grant\n"
            f"           roles/secretmanager.secretAccessor to the ESO service account.",
            file=sys.stderr,
        )

    env_var = _envvar_name(key)
    _ok(f"CRED_ADD {entry}  →  env var: {env_var}")
    print(f"\n  Session CR:  spec.subtrees: [\"users/{username}\"]")


# ---------------------------------------------------------------------------
# cred ls
# ---------------------------------------------------------------------------

def cmd_cred_ls(username: str, project: str) -> None:
    """List personal credential entries under users/<username>/."""
    subtree_label = f"users-{username}"
    client = _gsm_client()
    parent = f"projects/{project}"

    _info(f"Credentials for user '{username}' (users/{username}/):")
    found = 0
    try:
        for secret in client.list_secrets(
            parent=parent,
            filter=f'labels.omp_vault="true" AND labels.omp_subtree="{subtree_label}"',
        ):
            # secret.name = projects/<id>/secrets/<secret-id>
            sid = secret.name.rsplit("/", 1)[-1]
            # Reconstruct entry path: users-<name>-<key> → users/<name>/<key>
            entry_path = sid.replace("-", "/", 2)
            env_var = _envvar_name(sid.split("-")[-1])
            print(f"  {entry_path}  (env: {env_var})")
            found += 1
    except Exception as exc:
        _die(f"Failed to list secrets: {exc}")

    if found == 0:
        print(f"  (none — add with: ompctl cred add <key>)")


# ---------------------------------------------------------------------------
# vault add / vault ls  (admin-managed shared/ and users/<name>/ subtrees)
# ---------------------------------------------------------------------------

def cmd_vault_add(entry: str, project: str, eso_sa: Optional[str]) -> None:
    """Add/update a credential in GSM. Entry path: 'shared/<key>' or 'users/<name>/<key>'."""
    import re as _re
    if not _re.match(r'^[A-Za-z0-9_/.-]+$', entry):
        _die(f"Invalid entry '{entry}': alphanumeric, hyphens, underscores, slashes, dots only")

    # Auto-scope bare key to users/<current-user>/<key>
    if '/' not in entry:
        email = _gcloud_account()
        username = email.split('@')[0]
        entry = f'users/{username}/{entry}'
        _info(f'Auto-scoped to {entry}')

    secret_id = entry.replace('/', '-')
    subtree_label = entry.rsplit('/', 1)[0].replace('/', '-')
    parent = f'projects/{project}'
    secret_name = f'{parent}/secrets/{secret_id}'

    value = getpass.getpass(f'  Value for \'{entry}\' (hidden): ')
    if not value:
        _die('Empty value — aborted')

    client = _gsm_client()

    try:
        client.get_secret(name=secret_name)
        _info(f"Secret '{secret_id}' exists — adding new version")
    except Exception:
        _info(f"Creating GSM secret '{secret_id}'…")
        try:
            client.create_secret(
                parent=parent,
                secret_id=secret_id,
                secret={
                    'replication': {'automatic': {}},
                    'labels': {'omp_vault': 'true', 'omp_subtree': subtree_label},
                },
            )
        except Exception as exc:
            _die(f'Failed to create secret: {exc}')

    try:
        client.add_secret_version(
            parent=secret_name,
            payload={'data': value.encode('utf-8')},
        )
    except Exception as exc:
        _die(f'Failed to add secret version: {exc}')

    if eso_sa:
        try:
            policy = client.get_iam_policy(resource=secret_name)
            accessor_role = 'roles/secretmanager.secretAccessor'
            member = f'serviceAccount:{eso_sa}'
            for binding in policy.bindings:
                if binding.role == accessor_role:
                    if member not in binding.members:
                        binding.members.append(member)
                    break
            else:
                from google.iam.v1 import policy_pb2
                policy.bindings.add(role=accessor_role, members=[member])
            client.set_iam_policy(resource=secret_name, policy={'policy': policy})
        except Exception as exc:
            print(f'  WARNING: IAM grant failed — {exc}', file=sys.stderr)
    else:
        print(f'  WARNING: OMP_ESO_SA not set — grant secretAccessor manually', file=sys.stderr)

    env_var = _envvar_name(entry.split('/')[-1])
    _ok(f'VAULT_ADD {entry}  →  env var: {env_var}')


def cmd_vault_ls(subtree: str, project: str) -> None:
    """List vault entries. Default: shared/ and current user's entries."""
    client = _gsm_client()
    parent = f'projects/{project}'

    if not subtree:
        email = _gcloud_account()
        username = email.split('@')[0]
        user_label = f'users-{username}'
        _info(f"Vault entries (shared + users/{username}):")
        filter_str = f'labels.omp_vault="true" AND (labels.omp_subtree="shared" OR labels.omp_subtree="{user_label}")'
    else:
        sublabel = subtree.replace('/', '-')
        _info(f"Vault entries for subtree '{subtree}':")
        filter_str = f'labels.omp_vault="true" AND labels.omp_subtree="{sublabel}"'

    try:
        for secret in client.list_secrets(parent=parent, filter=filter_str):
            sid = secret.name.rsplit('/', 1)[-1]
            print(f'  {sid}  (env: {_envvar_name(sid.split("-")[-1])})')
    except Exception as exc:
        _die(f'Failed to list secrets: {exc}')


# ---------------------------------------------------------------------------
# session lifecycle — typed CR patch wrappers
# ---------------------------------------------------------------------------

def _k8s_custom() -> object:
    try:
        import kubernetes as _k8s
        try:
            _k8s.config.load_incluster_config()
        except Exception:
            _k8s.config.load_kube_config()
        return _k8s.client.CustomObjectsApi()
    except ImportError:
        _die('kubernetes Python library not installed — pip install kubernetes')


GROUP, VERSION, PLURAL = 'omp.mirantis.io', 'v1alpha1', 'sessions'


def _find_session_cr(name: str) -> tuple:
    """Find a Session CR by name across all omp CR namespaces. Returns (cr_ns, cr)."""
    import kubernetes as _k8s
    custom = _k8s_custom()
    core = _k8s.client.CoreV1Api()
    namespaces = [
        ns.metadata.name for ns in core.list_namespace().items
        if ns.metadata.name == 'omp-system' or ns.metadata.name.startswith('omp-team-')
    ]
    for cr_ns in namespaces:
        try:
            cr = custom.get_namespaced_custom_object(GROUP, VERSION, cr_ns, PLURAL, name)
            return cr_ns, cr
        except Exception:
            pass
    _die(f"Session '{name}' not found in any omp CR namespace")
    return ('', {})  # unreachable; keeps type checkers happy


def cmd_session_stop(name: str) -> None:
    """Stop a session (pod removed, PVC retained)."""
    cr_ns, _ = _find_session_cr(name)
    custom = _k8s_custom()
    custom.patch_namespaced_custom_object(
        GROUP, VERSION, cr_ns, PLURAL, name,
        {'spec': {'state': 'stopped'}},
    )
    _ok(f'SESSION_STOP {name} — pod removed; PVC + namespace retained')


def cmd_session_start(name: str) -> None:
    """Start (resume) a stopped session."""
    cr_ns, _ = _find_session_cr(name)
    custom = _k8s_custom()
    custom.patch_namespaced_custom_object(
        GROUP, VERSION, cr_ns, PLURAL, name,
        {'spec': {'state': 'running'}},
    )
    _ok(f'SESSION_START {name}')


def cmd_session_restart(name: str) -> None:
    """Force pod restart by bumping the restartedAt annotation."""
    import datetime
    cr_ns, _ = _find_session_cr(name)
    custom = _k8s_custom()
    custom.patch_namespaced_custom_object(
        GROUP, VERSION, cr_ns, PLURAL, name,
        {'metadata': {'annotations': {'omp.mirantis.io/restartedAt': datetime.datetime.utcnow().isoformat()}}},
    )
    _ok(f'SESSION_RESTART {name} — annotation bumped; pod will be recreated')


def cmd_session_link(name: str) -> None:
    """Print the current join link and view link for a session."""
    _cr_ns, cr = _find_session_cr(name)
    status = cr.get('status', {})
    join_link = status.get('joinLink', '')
    view_link = status.get('viewLink', '')
    phase = status.get('phase', 'unknown')
    if join_link:
        print(f'join: {join_link}')
        if view_link:
            print(f'view: {view_link}')
    else:
        print(f'No join link yet (phase={phase})')


# ---------------------------------------------------------------------------
# auth — interactive provider login inside session pod
# ---------------------------------------------------------------------------

def cmd_auth(session_name: str, provider: str, container: str = 'omp') -> None:
    """Run an interactive auth flow inside a running session pod."""
    import subprocess as _sp
    _, cr = _find_session_cr(session_name)
    ns = cr.get('status', {}).get('namespace', '')
    if not ns:
        _die(f"Session '{session_name}' has no status.namespace yet (still provisioning?)")
    pod = cr.get('status', {}).get('podName') or 'omp-0'

    base_cmd = ['kubectl', 'exec', '-it', '-n', ns, '-c', container, pod, '--', 'bash', '-lc']

    provider_cmds = {
        'anthropic':     'omp auth-broker login anthropic',
        'gcloud':        'gcloud auth login --no-browser',
        'aws':           'aws sso login --no-browser',
        'aws-configure': 'aws configure sso',
        'az':            'az login --use-device-code',
    }

    if provider == 'gh':
        token = getpass.getpass('  GitHub PAT (hidden): ')
        if not token:
            _die('No token entered')
        proc = _sp.run(
            base_cmd + ['gh auth login --with-token'],
            input=token, text=True,
        )
        if proc.returncode != 0:
            _die(f'gh auth login failed (exit {proc.returncode})')
    elif provider in provider_cmds:
        _sp.run(base_cmd + [provider_cmds[provider]], check=True)
    else:
        _die(f"Unknown provider '{provider}'. Valid: anthropic gcloud aws aws-configure az gh")


# ---------------------------------------------------------------------------
# port-forward
# ---------------------------------------------------------------------------

def cmd_port_forward(session_name: str, local_port: str, remote_port: str = '') -> None:
    """Forward a session pod port to localhost."""
    import subprocess as _sp
    _, cr = _find_session_cr(session_name)
    ns = cr.get('status', {}).get('namespace', '')
    if not ns:
        _die(f"Session '{session_name}' has no status.namespace yet")
    pod = cr.get('status', {}).get('podName') or 'omp-0'
    rport = remote_port or local_port
    _info(f'Forwarding localhost:{local_port} → pod {pod} in {ns}:{rport}')
    _info('Press Ctrl-C to stop.')
    _sp.run(['kubectl', 'port-forward', '-n', ns, f'pod/{pod}', f'{local_port}:{rport}'], check=True)




# ---------------------------------------------------------------------------
# Argument parsing (stdlib only)
# ---------------------------------------------------------------------------

def _parse_args(argv: list[str]) -> dict:
    """Minimal argument parser; no argparse dependency beyond stdlib."""
    if len(argv) < 2:
        _usage()

    cmd = argv[1]
    if cmd not in ("cred", "vault", "session", "auth", "port-forward"):
        _usage()

    # Defaults
    project = os.environ.get("GCP_PROJECT", "")
    eso_sa = os.environ.get("OMP_ESO_SA", "")
    user: Optional[str] = None
    key: Optional[str] = None

    if cmd == "cred":
        if len(argv) < 3:
            _usage()
        subcmd = argv[2]
        args = argv[3:]
        i = 0
        while i < len(args):
            if args[i] == "--user" and i + 1 < len(args):
                user = args[i + 1]; i += 2
            elif args[i] == "--project" and i + 1 < len(args):
                project = args[i + 1]; i += 2
            elif args[i] == "--eso-sa" and i + 1 < len(args):
                eso_sa = args[i + 1]; i += 2
            elif not args[i].startswith("--"):
                key = args[i]; i += 1
            else:
                _die(f"Unknown option: {args[i]}")
        return {
            "cmd": cmd, "subcmd": subcmd, "key": key,
            "user": user, "project": project, "eso_sa": eso_sa or None,
        }

    if cmd == "vault":
        if len(argv) < 3:
            _usage()
        subcmd = argv[2]
        args = argv[3:]
        entry: Optional[str] = None
        i = 0
        while i < len(args):
            if args[i] == "--project" and i + 1 < len(args):
                project = args[i + 1]; i += 2
            elif args[i] == "--eso-sa" and i + 1 < len(args):
                eso_sa = args[i + 1]; i += 2
            elif not args[i].startswith("--"):
                entry = args[i]; i += 1
            else:
                _die(f"Unknown option: {args[i]}")
        return {
            "cmd": cmd, "subcmd": subcmd, "entry": entry,
            "project": project, "eso_sa": eso_sa or None,
        }

    if cmd == "session":
        if len(argv) < 3:
            _usage()
        subcmd = argv[2]
        if len(argv) < 4:
            _die(f"Usage: ompctl session {subcmd} <name>")
        return {"cmd": cmd, "subcmd": subcmd, "name": argv[3]}

    if cmd == "auth":
        if len(argv) < 4:
            _die("Usage: ompctl auth <session> <provider> [<container>]")
        return {
            "cmd": cmd,
            "session_name": argv[2],
            "provider": argv[3],
            "container": argv[4] if len(argv) > 4 else "omp",
        }

    if cmd == "port-forward":
        if len(argv) < 4:
            _die("Usage: ompctl port-forward <session> <local-port> [<remote-port>]")
        return {
            "cmd": cmd,
            "session_name": argv[2],
            "local_port": argv[3],
            "remote_port": argv[4] if len(argv) > 4 else "",
        }

    _usage()
    return {}  # unreachable; satisfies type checkers


def _usage() -> None:
    print(__doc__, file=sys.stderr)
    sys.exit(1)


def main() -> None:
    parsed = _parse_args(sys.argv)
    cmd = parsed["cmd"]

    if cmd == "cred":
        subcmd = parsed["subcmd"]
        project = parsed["project"]
        if not project:
            _die("GCP project not set — export GCP_PROJECT=<id> or pass --project <id>")
        account = parsed["user"]
        if not account:
            email = _gcloud_account()
            account = email.split("@")[0]
        if subcmd == "add":
            if not parsed["key"]:
                _die("Usage: ompctl cred add <key> [--user <name>] [--project <id>]")
            cmd_cred_add(parsed["key"], account, project, parsed["eso_sa"])
        elif subcmd == "ls":
            cmd_cred_ls(account, project)
        else:
            _usage()

    elif cmd == "vault":
        subcmd = parsed["subcmd"]
        project = parsed["project"]
        if not project:
            _die("GCP project not set — export GCP_PROJECT=<id> or pass --project <id>")
        if subcmd == "add":
            if not parsed["entry"]:
                _die("Usage: ompctl vault add <entry> [--project <id>]")
            cmd_vault_add(parsed["entry"], project, parsed["eso_sa"])
        elif subcmd == "ls":
            cmd_vault_ls(parsed.get("entry") or "", project)
        else:
            _usage()

    elif cmd == "session":
        subcmd = parsed["subcmd"]
        name = parsed["name"]
        if subcmd == "stop":
            cmd_session_stop(name)
        elif subcmd == "start":
            cmd_session_start(name)
        elif subcmd == "restart":
            cmd_session_restart(name)
        elif subcmd == "link":
            cmd_session_link(name)
        else:
            _usage()

    elif cmd == "auth":
        cmd_auth(parsed["session_name"], parsed["provider"], parsed["container"])

    elif cmd == "port-forward":
        cmd_port_forward(parsed["session_name"], parsed["local_port"], parsed["remote_port"])

    else:
        _usage()


if __name__ == "__main__":
    main()
